{
  // Exclude heavy or irrelevant folders from search / indexing
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/coverage": true
  },
  // Don’t search inside heavy folders
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/coverage": true
  },
  // Prevent VS Code from watching these files (saves CPU/RAM)
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true
  },
  // Editor quality of life
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  // Keep AI suggestions manual instead of auto (so Codex won’t lag)
  "editor.inlineSuggest.enabled": false,
  "CodeGPT.apiKey": "OpenAI"
}